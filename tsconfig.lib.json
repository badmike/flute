{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/library/types",
    "rootDir": "src",
    "types": [
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "src/index.ts",
    "src/core",
    "src/dom",
    "src/react",
    "src/preview",
    "src/vue",
    "src/preview-vue"
  ],
  "exclude": [
    "demo",
    "tests"
  ]
}
